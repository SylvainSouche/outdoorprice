{
  "name": "outdoorprice",
  "version": "0.14.28",
  "private": true,
  "description": "Price comparison scraper for outdoor/cycling/sports gear across 22 European shops",
  "main": "dist-electron-src/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "NODE_ENV=production next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-site": "bun run scripts/cli/check-site.ts",
    "scrape-all": "bun run scripts/cli/scrape-all.ts",
    "playwright:install": "playwright install chromium",
    "electron:dev": "bun run electron:compile && electron electron/main.js",
    "electron:build": "next build && node scripts/prepare-electron-standalone.js && electron-builder",
    "electron:compile": "bunx tsc electron/main.ts electron/preload.ts --outDir dist-electron-src --module commonjs --target es2020 --moduleResolution node --skipLibCheck"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.82.0",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socks-proxy-agent": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.outdoorprice.app",
    "productName": "OutdoorPrice",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist-electron-src/**/*",
      "package.json",
      "next.config.ts"
    ],
    "extraResources": [
      {
        "from": "electron-resources/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.shopping",
      "target": [
        "dmg"
      ],
      "icon": "public/icon-mac.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-256.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png",
      "category": "Utility"
    }
  }
}
